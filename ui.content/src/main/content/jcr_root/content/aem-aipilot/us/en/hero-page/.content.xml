<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Hero Page"
        cq:template="/conf/aem-aipilot/settings/wcm/templates/page-content"
        sling:resourceType="aem-aipilot/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="aem-aipilot/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="aem-aipilot/components/container">
                <title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="aem-aipilot/components/title"
                    jcr:title="Hero Page Test"/>
                <container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="aem-aipilot/components/container"
                    layout="responsiveGrid">
                    <hero
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="aem-aipilot/components/hero"
                        headline="Welcome to Merkle"
                        description="AEM AI Pilot hero component with image background and call to action."
                        backgroundType="image"
                        imageRef="/content/dam/aem-aipilot/asset.jpg"
                        opacity="50"
                        horizontalAlignment="center"
                        verticalAlignment="middle"
                        ctaText="Learn More"
                        ctaLink="/content/aem-aipilot/us/en"
                        ctaTarget="_self"
                        cq:styleIds="[hero-color-white]">
                        <cq:responsive jcr:primaryType="nt:unstructured">
                            <default
                                jcr:primaryType="nt:unstructured"
                                offset="0"
                                width="12"/>
                        </cq:responsive>
                    </hero>
                </container>
            </container>
        </root>
    </jcr:content>
</jcr:root>
