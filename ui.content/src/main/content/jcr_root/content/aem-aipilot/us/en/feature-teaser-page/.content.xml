<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Feature Teaser Page"
        cq:template="/conf/aem-aipilot/settings/wcm/templates/page-content"
        sling:resourceType="aem-aipilot/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="aem-aipilot/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="aem-aipilot/components/container">
                <title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="aem-aipilot/components/title"
                    jcr:title="Feature Teaser Page"/>
                <container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="aem-aipilot/components/container"
                    layout="responsiveGrid">
                    <featured-teaser
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="aem-aipilot/components/featured-teaser"
                        preTitle="Featured Content"
                        headline="Discover Our Latest Innovation"
                        description="Experience the next generation of digital experiences powered by AI."
                        variant="fullscreen"
                        imageRef="/content/dam/aem-aipilot/asset.jpg"
                        ctaText="Learn More"
                        ctaLink="/content/aem-aipilot/us/en"
                        ctaTarget="_self"
                        cq:styleIds="[featured-teaser-color-white]">
                        <cq:responsive jcr:primaryType="nt:unstructured">
                            <default
                                jcr:primaryType="nt:unstructured"
                                offset="0"
                                width="12"/>
                        </cq:responsive>
                    </featured-teaser>
                </container>
            </container>
        </root>
    </jcr:content>
</jcr:root>
